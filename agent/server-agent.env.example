# =============================================================================
# Neko Family Proxy — Server Monitoring Agent Environment Configuration
# Template location: /etc/neko/server-agent.env (chmod 600)
# =============================================================================

# Server Identifier
SERVER_ID=japan-vps-1

# Backend Ingest Endpoint
INGEST_URL=https://your-admin-app.vercel.app/api/server/metrics/ingest

# Pre-shared high-entropy ingest secret (Bearer token)
# Must match SERVER_METRICS_INGEST_SECRET configured on Vercel
SERVER_METRICS_INGEST_SECRET=replace-with-high-entropy-random-secret

# Upstream Ping Probe Target (Optional: PSO2 JP endpoint or Japan IX gateway)
UPSTREAM_MONITOR_TARGET=gs001.pso2.jp

# Network Interface Override (Optional: leave blank for default route discovery)
# NETWORK_INTERFACE=eth0

# Shadowsocks Service Monitoring
SHADOWSOCKS_SYSTEMD_UNIT=shadowsocks-libev
SHADOWSOCKS_LOCAL_HOST=127.0.0.1
SHADOWSOCKS_LOCAL_PORT=8388

# Sample Cadence (seconds: 5 to 10)
SAMPLE_CADENCE_SECONDS=5
PING_CADENCE_SECONDS=30
